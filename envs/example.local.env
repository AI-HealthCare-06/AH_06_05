# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# redis
REDIS_HOST=redis
REDIS_PORT=6379

# db
DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_NAME=ai_health
PGDATABASE=postgres

# 안전성 점검 DB (심평원 DUR을 정리한 sqlite 파일 경로). 없으면 분석의 안전성 단계가 SAFETY_CHECK_FAILED로 끝나요
SAFETY_DB_PATH=
SAFETY_COMBO_EXT=false

# OCR 약 이름 비슷한 이름 추천 기준 (0.70, 0이면 끔)
OCR_SIMILAR_MIN=0.70

# 읽힌 이름과 글자 하나 차이인 다른 성분의 약이 있으면 사용자가 고르게 함 (기본 true, false면 끔)
OCR_SIBLING_CONFIRM=true

# OCR 약 이름 LLM 후보정 (기본 꺼짐). 켜면 규칙이 못 찾은 약 이름 글자만 OpenAI로 보내고, 답은 급여목록에서 다시 확인해 "추천"으로만 씀
OCR_LLM_FIX=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# 처방전 사진 임시 저장 (비우면 저장하지 않음. s3 = S3 버킷, disk = 서버 폴더) 올린 지 24시간이 지나면 지움
PHOTO_STORAGE=
PHOTO_RETENTION_HOURS=24
PHOTO_S3_BUCKET=
PHOTO_S3_REGION=ap-northeast-2
PHOTO_DISK_DIR=./photo_store

# OCR을 arq 워커에서 돌릴지. 켜려면 PHOTO_STORAGE도 켜져 있어야 하고, ai-worker 컨테이너가 새 이미지로 떠 있는 것을 확인한 뒤에 true로 한다
# (워커가 꺼져 있으면 서버 안에서 처리하지만, 켜 둔 채 워커만 죽으면 최대 30초 동안은 대기열에 들어갈 수 있다)
OCR_WORKER=false
OCR_WORKER_MAX_TRIES=2
OCR_WORKER_RETRY_DELAY_SEC=20
OCR_WORKER_TIMEOUT_SEC=300
OCR_UPLOAD_WAIT_SEC=8
