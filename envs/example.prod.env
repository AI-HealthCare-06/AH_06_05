# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=postgres
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_NAME=ai_health
PGDATABASE=postgres

# redis
REDIS_HOST=redis
REDIS_PORT=6379

SAFETY_DB_PATH=
SAFETY_COMBO_EXT=false

# 처방전 사진 임시 저장. 서버에 저장 기능을 배포하고 앱 안내문을 바꿀 때 PHOTO_STORAGE=s3 로 켠다 (비우면 저장하지 않음)
# 접근 키는 넣지 않는다: EC2에 붙인 역할(IAM)로 접근한다
PHOTO_STORAGE=
PHOTO_RETENTION_HOURS=24
PHOTO_S3_BUCKET=ah06-5-prescription-photos
PHOTO_S3_REGION=ap-northeast-2

# OCR을 arq 워커에서 돌릴지. 켜려면 PHOTO_STORAGE도 켜져 있어야 하고, ai-worker 컨테이너가 새 이미지로 떠 있는 것을 확인한 뒤에 true로 한다
# (워커가 꺼져 있으면 서버 안에서 처리하지만, 켜 둔 채 워커만 죽으면 최대 30초 동안은 대기열에 들어갈 수 있다)
OCR_WORKER=false
OCR_WORKER_MAX_TRIES=2
OCR_WORKER_RETRY_DELAY_SEC=20
OCR_WORKER_TIMEOUT_SEC=300
OCR_UPLOAD_WAIT_SEC=8
